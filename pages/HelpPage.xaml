<UserControl x:Class="superClipboard.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:superClipboard"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TextBlock x:Name="PageTitle" Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Margin="16,0,16,16">
                <!-- 监听面板 -->
                <ui:TextBlock x:Name="HelpMonitorTitle" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock x:Name="HelpMonitorBody" TextWrapping="Wrap" Margin="8,0,0,4" LineHeight="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- 剪贴板历史 -->
                <ui:TextBlock x:Name="HelpHistoryTitle" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock x:Name="HelpHistoryBody" TextWrapping="Wrap" Margin="8,0,0,4" LineHeight="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- 粘贴数字键功能 -->
                <ui:TextBlock x:Name="HelpPasteQueueTitle" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock x:Name="HelpPasteQueueBody" TextWrapping="Wrap" Margin="8,0,0,4" LineHeight="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- Excel 编辑模式 -->
                <ui:TextBlock x:Name="HelpExcelTitle" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock x:Name="HelpExcelBody" TextWrapping="Wrap" Margin="8,0,0,4" LineHeight="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- 文件发送 -->
                <ui:TextBlock x:Name="HelpFileSendTitle" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock x:Name="HelpFileSendBody" TextWrapping="Wrap" Margin="8,0,0,4" LineHeight="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- 文件接收 -->
                <ui:TextBlock x:Name="HelpFileReceiveTitle" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock x:Name="HelpFileReceiveBody" TextWrapping="Wrap" Margin="8,0,0,4" LineHeight="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- 设置 -->
                <ui:TextBlock x:Name="HelpSettingsTitle" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock x:Name="HelpSettingsBody" TextWrapping="Wrap" Margin="8,0,0,4" LineHeight="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
