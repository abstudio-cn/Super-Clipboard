<UserControl x:Class="superClipboard.FileSendPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:superClipboard"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TextBlock x:Name="PageTitle" Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="10" Padding="10">
            <StackPanel>
                <ui:TextBlock x:Name="LblSelectFile" FontWeight="Bold" Margin="0,0,0,5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilePathTextBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,10,0"/>
                    <ui:Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseButton_Click"/>
                </Grid>
                <ui:TextBlock x:Name="FileInfoText" Margin="0,5,0,0" Foreground="Gray"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="10" Padding="10">
            <StackPanel>
                <ui:TextBlock x:Name="LblSendSettings" FontWeight="Bold" Margin="0,0,0,5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <CheckBox x:Name="CompressCheckBox" IsChecked="True" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock x:Name="LblChunkSize" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBox Grid.Column="1" x:Name="ChunkSizeNumberBox" Text="1000" Margin="0,0,5,0"/>
                    <ui:TextBlock x:Name="LblChunkUnit" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Grid>
                <CheckBox x:Name="ShowNotificationsCheckBox" IsChecked="True" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="10" Padding="10">
            <StackPanel>
                <ui:TextBlock x:Name="LblProgress" FontWeight="Bold" Margin="0,0,0,5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock x:Name="LblStatus" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Grid.Column="1" x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Grid.Column="2" x:Name="ProgressPercentText" Text="0%" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Grid>
                <ProgressBar x:Name="SendProgressBar" Minimum="0" Maximum="100" Value="0" Margin="0,5,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" x:Name="ChunksText" VerticalAlignment="Center"  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Grid.Column="1" x:Name="CharactersText" VerticalAlignment="Center" HorizontalAlignment="Right"  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="StartSendButton" Grid.Column="0" Click="StartSendButton_Click" HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
            <ui:Button x:Name="PauseButton" Grid.Column="1" Click="PauseButton_Click" HorizontalAlignment="Stretch" Margin="5,0,5,0" IsEnabled="False"/>
            <ui:Button x:Name="CancelButton" Grid.Column="2" Click="CancelButton_Click" HorizontalAlignment="Stretch" Margin="5,0,0,0"/>
        </Grid>

        <ui:Button x:Name="SendNoClientButton" Grid.Row="5" Click="SendNoClientButton_Click" HorizontalAlignment="Stretch" Margin="10,0,10,10" IsEnabled="False"/>
    </Grid>
</UserControl>
