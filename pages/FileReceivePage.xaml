<UserControl x:Class="superClipboard.FileReceivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:superClipboard"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TextBlock x:Name="PageTitle" Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="10" Padding="10">
            <StackPanel>
                <ui:TextBlock x:Name="LblReceiveSettings" FontWeight="Bold" Margin="0,0,0,5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock x:Name="LblSavePath" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBox Grid.Column="1" x:Name="SavePathTextBox" IsReadOnly="True" Margin="0,0,10,0"/>
                    <ui:Button x:Name="BrowseSaveButton" Grid.Column="2" Click="BrowseSavePathButton_Click"/>
                </Grid>
                <CheckBox x:Name="AutoDetectCheckBox" Margin="0,5,0,0"/>
                <CheckBox x:Name="ShowNotificationsCheckBox" Margin="0,5,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock x:Name="LblReceiveMode" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox Grid.Column="1" x:Name="ReceiveModeComboBox" SelectedIndex="0">
                        <ComboBoxItem x:Name="ModeBase93"/>
                        <ComboBoxItem x:Name="ModeBase64"/>
                        <ComboBoxItem x:Name="ModeText"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="10" Padding="10">
            <StackPanel>
                <ui:TextBlock x:Name="LblReceiveProgress" FontWeight="Bold" Margin="0,0,0,5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock x:Name="LblStatus" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Grid.Column="1" x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Grid.Column="2" x:Name="ProgressPercentText" Text="0%" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Grid>
                <ProgressBar x:Name="ReceiveProgressBar" Minimum="0" Maximum="100" Value="0" Margin="0,5,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" x:Name="ChunksText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Grid.Column="1" x:Name="CharactersText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Grid>
                
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3" Margin="0,10,0,0" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ui:TextBlock x:Name="LblPreview" Grid.Row="0" FontWeight="Bold" Margin="0,0,0,5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ScrollViewer Grid.Row="1" MaxHeight="150">
                            <TextBox x:Name="PreviewTextBox" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="StartListeningButton" Grid.Column="0" Click="StartListeningButton_Click" HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
            <ui:Button x:Name="StopListeningButton" Grid.Column="1" Click="StopListeningButton_Click" HorizontalAlignment="Stretch" Margin="5,0,5,0" IsEnabled="False"/>
            <ui:Button x:Name="ClearCacheButton" Grid.Column="2" Click="ClearCacheButton_Click" HorizontalAlignment="Stretch" Margin="5,0,5,0"/>
            <ui:Button x:Name="SaveFileButton" Grid.Column="3" Click="SaveFileButton_Click" HorizontalAlignment="Stretch" Margin="5,0,0,0" IsEnabled="False"/>
        </Grid>
    </Grid>
</UserControl>
