<UserControl  x:Class="superClipboard.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:superClipboard"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ui:TextBlock x:Name="SectionHotkey" Grid.Row="0" FontTypography="Title" Margin="0,0,0,45" Grid.RowSpan="2"  />
        <!-- 普通粘贴快捷键 -->
        <ui:TextBlock x:Name="LblNormalPaste" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Height="22"/>
        <TextBox x:Name="txtNormalPaste" Grid.Row="1" Grid.Column="1" Margin="5,5,5,5" 
                 IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" 
                 ToolTip="点击后按下组合键"/>

        <!-- 模拟按键粘贴快捷键 -->
        <Label x:Name="LblKeystrokesPaste" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"  Height="22"/>
        <TextBox x:Name="txtKeystrokesPaste" Grid.Row="2" Grid.Column="1" Margin="5,5,5,5" 
                 IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                 ToolTip="点击后按下组合键"/>

        <!-- 停止模拟输入快捷键 -->
        <Label x:Name="LblStopSimulation" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"  Height="22"/>
        <TextBox x:Name="txtStopSimulation" Grid.Row="3" Grid.Column="1" Margin="5,5,5,5" 
                 IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                 ToolTip="点击后按下组合键（模拟输入过程中按下可中止）"/>

        <!-- 历史指定粘贴等待时间（数字键选择窗口，200-2000ms，200ms 步进） -->
        <Label x:Name="LblHistoryPasteWait" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"  Height="22"/>
        <Grid Grid.Row="4" Grid.Column="1" Margin="5,5,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="HistoryPasteWaitSlider" Grid.Column="0"
                    Minimum="200" Maximum="2000" TickFrequency="200"
                    IsSnapToTickEnabled="True" SmallChange="200" LargeChange="200"
                    VerticalAlignment="Center"
                    ValueChanged="HistoryPasteWait_ValueChanged"/>
            <TextBlock x:Name="TxtHistoryPasteWait" Grid.Column="1" VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="5" Grid.Column="1" BorderBrush="Gray" BorderThickness="0,1,0,0" Margin="0,30,0,20" />

        <!-- 剪贴板设置 -->
        <ui:TextBlock x:Name="SectionClipboard" Grid.Row="6" FontTypography="Title" Margin="0,0,0,45" Grid.RowSpan="2"  />
        <Label x:Name="LblExcelMode" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"  Height="22"/>
        <ui:ToggleSwitch x:Name="ExcelModeSwitch" Grid.Row="7" Grid.Column="1" 
                         Checked="ExcelMode_Checked" Unchecked="ExcelMode_Unchecked"/>

        <!-- Excel 编辑模式开关快捷键 -->
        <Label x:Name="LblExcelHotkey" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"  Height="22"/>
        <TextBox x:Name="txtExcelHotkey" Grid.Row="8" Grid.Column="1" Margin="5,5,5,5" 
                 IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                 ToolTip="点击后按下组合键"/>

        <Border Grid.Row="9" Grid.Column="1" BorderBrush="Gray" BorderThickness="0,1,0,0" Margin="0,30,0,20" />

        <ui:TextBlock x:Name="SectionLanguage" Grid.Row="10" FontTypography="Title" Margin="0,0,0,45" Grid.RowSpan="2"  />
        <Label x:Name="LblSelectLang" Grid.Row="11" Grid.Column="0" VerticalAlignment="Center"  Height="22"/>
        <ComboBox x:Name="LanguageComboBox" Grid.Row="11" Grid.Column="1" Margin="5,5,5,5" 
                  Width="200" HorizontalAlignment="Left"
                  SelectionChanged="LanguageComboBox_SelectionChanged"/>

        <Border Grid.Row="12" Grid.Column="1" BorderBrush="Gray" BorderThickness="0,1,0,0" Margin="0,30,0,20" />

        <ui:TextBlock x:Name="SectionTheme" Grid.Row="13" FontTypography="Title" Margin="0,0,0,45" Grid.RowSpan="2"  />
        <Label x:Name="LblCurrentTheme" Grid.Row="14" Grid.Column="0" VerticalAlignment="Center"  Height="22"/>
        <ui:ToggleSwitch x:Name="DNSwitch" Grid.Row="14" Grid.Column="1" OffContent="Light" OnContent="Dark" Checked="ThemeToggle_Checked" Unchecked="ThemeToggle_Unchecked"/>

        <Border Grid.Row="15" Grid.Column="1" BorderBrush="Gray" BorderThickness="0,1,0,0" Margin="0,30,0,20" />

        <ui:TextBlock x:Name="SectionBackground" Grid.Row="16" FontTypography="Title" Margin="0,0,0,45" Grid.RowSpan="2"  />
        <Label x:Name="LblBgImage" Grid.Row="17" Grid.Column="0" VerticalAlignment="Center"  Height="22"/>
        <Grid Grid.Row="17" Grid.Column="1" Margin="5,5,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtBackgroundPath" Grid.Column="0" 
                     IsReadOnly="True" VerticalAlignment="Center"
                     ToolTip="当前背景图片路径"
                     Text="未设置"/>
            <ui:Button x:Name="btnBrowseBg" Grid.Column="1" 
                       Width="60" Margin="5,0"
                       Click="BtnBrowseBg_Click"/>
            <ui:Button x:Name="btnClearBg" Grid.Column="2" 
                       Width="60"
                       Click="BtnClearBg_Click"/>
        </Grid>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="19" Orientation="Vertical" HorizontalAlignment="Right" Margin="5" Grid.ColumnSpan="2">
            <ui:Button x:Name="btnSave" Width="100" Margin="5" Click="BtnSave_Click"/>
        </StackPanel>

    </Grid>
    </ScrollViewer>
</UserControl>
