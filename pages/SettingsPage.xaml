<UserControl  x:Class="superClipboard.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:superClipboard"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="44.78"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ui:TextBlock Grid.Row="0" FontTypography="Title" Text="按键设置" Margin="0,0,0,45" Grid.RowSpan="2"  />
        <!-- 普通粘贴快捷键 -->
        <ui:TextBlock Grid.Row="1" Grid.Column="0" Text="普通粘贴:" VerticalAlignment="Center" Height="22"/>
        <TextBox x:Name="txtNormalPaste" Grid.Row="1" Grid.Column="1" Margin="5,5,5,5" 
                 IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" 
                 ToolTip="点击后按下组合键"/>

        <!-- 模拟按键粘贴快捷键 -->
        <Label Grid.Row="2" Grid.Column="0" Content="模拟按键粘贴:" VerticalAlignment="Center"  Height="22"/>
        <TextBox x:Name="txtKeystrokesPaste" Grid.Row="2" Grid.Column="1" Margin="5,5,5,5" 
                 IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                 ToolTip="点击后按下组合键"/>

        <Border Grid.Row="3" Grid.Column="1" BorderBrush="Gray" BorderThickness="0,1,0,0" Margin="0,30,0,20" />
        <ui:TextBlock Grid.Row="4" FontTypography="Title" Text="主题设置" Margin="0,0,0,45" Grid.RowSpan="2"  />
        <Label Grid.Row="5" Grid.Column="0" Content="当前主题" VerticalAlignment="Center"  Height="22"/>
        <ui:ToggleSwitch x:Name="DNSwitch" Grid.Row="5" Grid.Column="1" OffContent="白日" OnContent="夜间" Checked="ThemeToggle_Checked" Unchecked="ThemeToggle_Unchecked"/>
        <!-- 按钮区域 -->
        <StackPanel Grid.Row="10" Orientation="Vertical"  HorizontalAlignment="Right" Margin="5" Grid.ColumnSpan="2">
            <ui:Button x:Name="btnSave" Content="保存" Width="100" Margin="5" Click="BtnSave_Click"/>
        </StackPanel>

    </Grid>
</UserControl>
