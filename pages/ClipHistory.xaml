<UserControl x:Class="superClipboard.ClipHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:superClipboard"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <local:DataTypeToIconConverter x:Key="DataTypeToIconConverter"/>
        <local:ClipboardDataPreviewConverter x:Key="PreviewConverter"/>
        <local:FileInfoConverter x:Key="FileInfoConverter"/>
        <local:FavoriteIconConverter x:Key="FavoriteIconConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="BtnPasteQueueMode" Click="PasteQueueMode_Click" Margin="5" ToolTip="循环切换：开启列表粘贴 → 顺序粘贴 → 倒序粘贴"/>
            <Button x:Name="BtnClearHistory" Click="ClearHistory_Click" Margin="5"/>
        </StackPanel>

        <!-- 历史列表 -->
        <ListBox x:Name="HistoryListBox" Grid.Row="1" Margin="10"
                 MouseDoubleClick="HistoryListBox_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Padding="5" Margin="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标 -->
                            <TextBlock Grid.Column="0" Text="{Binding Type, Converter={StaticResource DataTypeToIconConverter}}" 
                                       FontFamily="Segoe UI Symbol" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>

                            <!-- 详细信息 -->
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" Foreground="Gray" FontSize="10"/>
                                <!-- 文本内容 -->
                                <TextBlock x:Name="TextPreview" 
                                           Text="{Binding TextContent}" 
                                           TextWrapping="Wrap" 
                                           MaxHeight="60" 
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                                <!-- 图片预览 -->
                                <TextBlock x:Name="ImagePreviewText" 
                                           Text="[图片]"
                                           Foreground="DarkGray"
                                           FontStyle="Italic"
                                           Margin="0,2,0,0"
                                           Visibility="Collapsed"/>
                                <!-- 文件信息 -->
                                <TextBlock x:Name="FilePreview" 
                                           Text="{Binding ., Converter={StaticResource FileInfoConverter}}"
                                           TextWrapping="Wrap"
                                           MaxHeight="40"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- 类型标识 -->
                            <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="Blue" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            
                            <!-- 收藏按钮 -->
                            <Button Grid.Column="3" 
                                    Content="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                    FontSize="16"
                                    Foreground="Gold"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="2"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    Tag="{Binding}"
                                    Click="FavoriteButton_Click"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Type}" Value="Text">
                            <Setter TargetName="TextPreview" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Image">
                            <Setter TargetName="ImagePreviewText" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Files">
                            <Setter TargetName="FilePreview" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>