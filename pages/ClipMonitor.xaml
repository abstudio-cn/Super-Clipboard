<UserControl x:Class="superClipboard.ClipMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:superClipboard"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Unloaded="UserControl_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <ui:TextBlock x:Name="LblShortcutHint" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:TextBlock x:Name="LblShortcutNormal" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:TextBlock x:Name="LblShortcutSimulate" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" 
                    CornerRadius="5" Margin="0,0,0,10" Padding="10">
                <StackPanel>
                    <TextBlock x:Name="LblCurrentClipboard" FontWeight="Bold" Margin="0,0,0,5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <StackPanel x:Name="InfoPanel">
                        <TextBlock x:Name="DataTypeText" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="TimeText" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" 
                    CornerRadius="5" Padding="10">
                <ScrollViewer Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Grid>
                        <TextBox x:Name="TextContentBox" 
                               TextWrapping="Wrap" 
                               VerticalScrollBarVisibility="Auto"
                               IsReadOnly="True"
                               Visibility="Collapsed"/>
                        <Image x:Name="ImageContentBox" 
                               Stretch="Uniform"
                               Visibility="Collapsed"/>
                        <ListBox x:Name="FileListBox" 
                               Visibility="Collapsed"/>
                        <TextBlock x:Name="NoContentText" 
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
